#include<stdio.h>
int main()
{
int a[10],n,i,pos,value;
printf("enter the number of element:");
scanf("%d",&n);
printf("enter element:\n");
for(i=0;i<n;i++)
scanf("%d",&a[i]);
printf("enter the position of insert:");
scanf("%d",& pos);
printf("enter the value:");
scanf("%d",& value);
for(i=n;i>=pos;i--)
a[i]=a[i-1];
a[pos-1]=value;
n++;
printf("array:\n");
for(i=0;i,n;i++);
printf("%d",a[i]);
return 0;
}
